{
  "tasks": {
    "dev": "deno run -A npm:vite & deno run server:start",
    "build": "deno run -A npm:vite build",
    "server:start": "deno run -A --watch ./api/main.ts",
    "serve": "deno run build && deno run server:start"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.1.6",
    "@tajpouria/cors": "jsr:@tajpouria/cors@^1.2.1",
    "@types/react": "npm:@types/react@^19.2.2",
    "@types/react-dom": "npm:@types/react-dom@^19.2.2",
    "@vitejs/plugin-react-swc": "npm:@vitejs/plugin-react-swc@^4.2.0",
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "vite": "npm:vite@^7.1.12"
  }
}
