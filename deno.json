{
  "tasks": {
    "dev": "deno run vite:dev & deno run server:watch",
    "prod": "deno run vite:build && deno run server:start",
    "vite:dev": "deno run --unstable-no-legacy-abort -A npm:vite dev",
    "vite:build": "deno run -A npm:vite build",
    "server:watch": "deno run -A --watch ./api/main.ts",
    "server:start": "deno run -A ./api/main.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@types/cors": "npm:@types/cors@^2.8.19",
    "@types/express": "npm:@types/express@^5.0.5",
    "@types/react": "npm:@types/react@^19.2.2",
    "@types/react-dom": "npm:@types/react-dom@^19.2.2",
    "@vitejs/plugin-react-swc": "npm:@vitejs/plugin-react-swc@^4.2.0",
    "cors": "npm:cors@^2.8.5",
    "express": "npm:express@^5.1.0",
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "vite": "npm:vite@^7.1.12"
  }
}
